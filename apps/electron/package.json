{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Electron desktop shell: boots the harness host in the main process, serves the web client over dsh:// with IPC bridging, native dialogs and window chrome",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/electron"
  },
  "type": "module",
  "main": "lib/main.js",
  "files": [
    "lib/*.js",
    "lib/*.cjs",
    "config"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "generate-icons": "node scripts/generate-icons.mjs",
    "dist": "npm run generate-icons && electron-builder",
    "dist:dir": "npm run generate-icons && electron-builder --dir"
  },
